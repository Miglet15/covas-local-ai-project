# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
.venv/
venv/

# ── Logs ──────────────────────────────────────────────────────────────────────
# Keep the logs/ folder but ignore the log file itself (can get very large)
logs/*.log
logs/*.log.*

# ── Runtime data ──────────────────────────────────────────────────────────────
# Memories are written at runtime — exclude from version control
data/covas_memories.json

# ── Secrets / local overrides ─────────────────────────────────────────────────
# If you ever create a local config override, keep it out of the repo
config/config.local.json
